# EmailJS — lag en gratis konto på https://www.emailjs.com
# Kopier denne filen til .env.local og fyll inn. Legg de samme verdiene inn i
# Vercel under Project → Settings → Environment Variables.
#
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Lanseres snart: produksjonsbygg viser coming soon-siden som standard.
# Sett til false (i Vercel → Production) den dagen hele siden skal lanseres.
# VITE_COMING_SOON=false
